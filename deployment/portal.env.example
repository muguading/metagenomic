# Copy to deployment/portal.env and replace all placeholders before production use.

PORTAL_MODE=production
PORTAL_SECRET_KEY=replace-with-output-of-python-secrets-token-urlsafe-48
PORTAL_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Set to 1 only when the service is served through HTTPS.
PORTAL_COOKIE_SECURE=0

# Container-facing paths used by docker-compose.portal.yml.
PORTAL_STATE_DIR=/data/pathogen-workbench/state
PORTAL_TASK_DIR=/data/pathogen-workbench/tasks
PORTAL_DB_PATH=/data/pathogen-workbench/state/bac_analysis_portal.sqlite3
BAC_ANALYSIS_TASK_ROOT=/data/pathogen-workbench/tasks
META_DATABASE_ROOT=/data/pathogen-db
CONDA_ROOT=/opt/pathogen-workbench/conda
PORTAL_CONDA_ROOT=/opt/pathogen-workbench/conda
CONDA_EXE=/opt/pathogen-workbench/conda/bin/conda
PORTAL_REQUIRED_CONDA_ENVS=web_runtime,meta_main,genomad_aux,amr_aux,host_filter,mag_aux,cm210,sistr_hicap,qiime2,microeco,genovi,plasflow,longread_aux,chewie,ncov,choleraefinder,report_env,Vlib,tNGS

# Optional database overrides. Leave blank until the assets are installed.
META_KRAKEN_DB=
META_VIRUS_KRAKEN_DB=
META_VIRSORTER2_DB=
META_CHECKV_DB=
META_GENOMAD_DB=
META_MOBILEOG_DB=
META_MOBILEOG_META=

# Gunicorn tuning.
APP_HOST=127.0.0.1
GUNICORN_WORKERS=2
APP_PORT=5055

# systemd/nginx bootstrap defaults used by deploy_bac_analysis_portal_ubuntu.sh.
SERVICE_NAME=bac-analysis-portal
SERVER_NAME=_
INSTALL_SYSTEM_PACKAGES=1
